APP_NAME=Govi-AI Backend
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://user:password@localhost:5432/goviai

#Authentication
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

#LLM
LLM_API_KEY=changeme
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_BASE_URL=https://openrouter.ai/api/v1

#Payhere
PAYHERE_MERCHANT_ID=changeme
PAYHERE_MERCHANT_SECRET=changeme
PAYHERE_MODE=sandbox

#Model artifacts location. Leave unset for local dev (resolves to
#<repo root>/ai_model/artifacts automatically). Set only for deployments
#where the Docker build context doesn't include the repo root, e.g. Fly.io:
#ARTIFACTS_DIR=/app/ai_model/artifacts